{
  "$schema": "https://raw.githubusercontent.com/LuaLS/vscode-lua/master/setting/schema.json",
  "workspace.library": [
    "/usr/share/nvim/runtime"
  ],
  "runtime.version": "LuaJIT",
  "hint.enable": false,
  "format.enable": true,
  "format.defaultConfig.indent_style": "space",
  "format.defaultConfig.indent_size": "2"
}
